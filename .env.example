# Copiar a .env para cambiar credenciales o puertos locales
PG_DB=rastro
PG_USER=rastro
PG_PASSWORD=rastro
PG_PORT=5434
ONTOP_PORT=8080
GRAPHDB_PORT=7210
GRAPHDB_HEAP=2g

# AACT: cuenta gratuita en https://aact.ctti-clinicaltrials.org/sign_up
AACT_USER=
AACT_PASSWORD=
# Alternativa sin cuenta en la nube: snapshot descargado a data/raw/ (ruta relativa a data/raw/)
AACT_DUMP=

# openFDA: key gratuita en https://open.fda.gov/apis/authentication/ (sin key: 1000 requests/día)
OPENFDA_API_KEY=

# LLM de Rastro Layer: anthropic (Claude API) u ollama (modelo local en la Mac)
RASTRO_PROVIDER=
# Claude API (https://platform.claude.com), de pago por uso
ANTHROPIC_API_KEY=
# Modelo; vacío = claude-opus-5-5 con anthropic, qwen2.5-coder:7b con ollama
RASTRO_MODEL=
# Ollama corre en la Mac, fuera de Docker; vacío = http://host.docker.internal:11434
OLLAMA_URL=
