# Una consulta, dos grafos: Rastro (petróleo y gas) y Wikidata (internet).
# Se ejecuta en GraphDB: http://localhost:7210/repositories/rastro
# Las empresas con LEI y su parte del petróleo de 2025, con lo que Wikidata sabe de cada una:
# dónde tiene la sede, en qué bolsa cotiza, quién es su dueño o matriz y su sitio web. El cruce es
# el LEI (identificador global de empresas, de GLEIF), que Rastro y Wikidata comparten.
PREFIX energia: <https://w3id.org/rastro/energia#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?empresa ?lei ?su_parte_m3 ?declara_m3 ?wikidata
       (GROUP_CONCAT(DISTINCT ?sede; separator=", ") AS ?sede_segun_wikidata)
       (GROUP_CONCAT(DISTINCT ?bolsa; separator=", ") AS ?cotiza_en)
       (GROUP_CONCAT(DISTINCT ?duenio; separator=", ") AS ?duenio_o_matriz)
       (SAMPLE(?web) AS ?sitio) WHERE {
  # Rastro: las empresas con LEI, el petróleo de 2025 que les corresponde según su participación en cada
  # concesión (el mismo número del paso 1 de la demo) y, aparte, todo el que declaran como operadoras
  SERVICE <http://ontop-energia:8080/sparql> {
    SELECT ?empresa ?lei (ROUND(SUM(?oil * ?percent / 100)) AS ?su_parte_m3) (ROUND(SAMPLE(?declarado)) AS ?declara_m3) WHERE {
      ?e energia:lei ?lei ; energia:name ?empresa .
      ?s a energia:Stake ; energia:inConcession ?c ; energia:partner ?e ; energia:percent ?percent .
      ?p a energia:WellProduction ; energia:inConcession ?c ; energia:oil ?oil .
      OPTIONAL { SELECT ?e (SUM(?o) AS ?declarado) WHERE { ?q energia:declaredBy ?e ; energia:oil ?o } GROUP BY ?e }
    } GROUP BY ?empresa ?lei
  }
  # Wikidata, en internet: la misma empresa por su LEI, y lo que ninguna fuente de Rastro tiene
  SERVICE <https://query.wikidata.org/sparql> {
    ?wikidata wdt:P1278 ?lei .
    OPTIONAL { ?wikidata wdt:P159/rdfs:label ?sede . FILTER (LANG(?sede) = "es") }
    OPTIONAL { ?wikidata wdt:P414/rdfs:label ?bolsa . FILTER (LANG(?bolsa) = "es") }
    OPTIONAL { ?wikidata wdt:P749|wdt:P127 ?d . ?d rdfs:label ?duenio . FILTER (LANG(?duenio) = "es") }
    OPTIONAL { ?wikidata wdt:P856 ?web }
  }
} GROUP BY ?empresa ?lei ?su_parte_m3 ?declara_m3 ?wikidata
ORDER BY DESC(?su_parte_m3)
