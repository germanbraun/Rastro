# Los contratos que lee el resumen: los 40 más grandes del grupo Leidos (todas sus empresas,
# ya resuelto por Rastro), con su descripción y la agencia que contrata.
PREFIX : <https://w3id.org/rastro/proveedores#>
SELECT ?contrato ?monto ?agencia ?empresa ?descripcion WHERE {
  ?c a :Contract ; :contractId ?contrato ; :amount ?monto ; :description ?descripcion ;
     :agency/:name ?agencia ; :supplier ?s .
  ?s :name ?empresa ; :group/:name "LEIDOS HOLDINGS, INC." .
}
ORDER BY DESC(?monto)
LIMIT 40
