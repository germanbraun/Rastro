# Mapeos R2RML del dominio de petróleo y gas: cómo se leen las tablas de Postgres como grafo.
# Los lee el tercer Ontop (ontop-energia, puerto 8082). Una sección por fuente.
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix energia: <https://w3id.org/rastro/energia#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- Fuentes (rastro_meta) -------------------------------------

<#DataSource> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """
        SELECT id, name, license FROM rastro_meta.source WHERE id IN ('capitulo4', 'sig_energia', 'enargas', 'ign', 'gleif', 'ambiental')""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/source/{id}" ; rr:class energia:DataSource ] ;
    rr:predicateObjectMap [ rr:predicate energia:name ; rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:license ; rr:objectMap [ rr:column "license" ] ] .

# --- Producción por pozo (Capítulo IV) ---------------------------

<#WellProduction> a rr:TriplesMap ;
    # Cada fila de las declaraciones juradas de 2025 (pozo, mes, concesión y empresa), leída de la tabla
    # original del Capítulo IV, como en oncología: si la fuente cambia una columna, se arregla una línea acá.
    rr:logicalTable [ rr:sqlQuery """
SELECT idpozo, mes, idareapermisoconcesion, idempresa, formacion, cuenca, provincia,
       prod_pet AS petroleo_m3, prod_gas AS gas_mm3
FROM capitulo4.produccion""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/production/{idpozo}/{mes}/{idareapermisoconcesion}/{idempresa}" ;
                    rr:class energia:WellProduction ] ;
    rr:predicateObjectMap [ rr:predicate energia:well ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/well/{idpozo}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{idareapermisoconcesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:formation ; rr:objectMap [ rr:column "formacion" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:basin ; rr:objectMap [ rr:column "cuenca" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:province ; rr:objectMap [ rr:column "provincia" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:oil ; rr:objectMap [ rr:column "petroleo_m3" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:gas ; rr:objectMap [ rr:column "gas_mm3" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/capitulo4> ] ] .

# Quién declara cada fila: la empresa, con el nombre unido entre fuentes (enlace de Rastro)
<#WellProductionCompany> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """
SELECT p.idpozo, p.mes, p.idareapermisoconcesion, p.idempresa, en.empresa_id
FROM capitulo4.produccion p
JOIN energia.empresa_nombre en ON en.fuente = 'capitulo4' AND en.nombre = trim(p.empresa)""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/production/{idpozo}/{mes}/{idareapermisoconcesion}/{idempresa}" ] ;
    rr:predicateObjectMap [ rr:predicate energia:declaredBy ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] .

<#ShaleProduction> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT idpozo, mes, idareapermisoconcesion, idempresa FROM capitulo4.produccion WHERE sub_tipo_recurso = 'SHALE'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/production/{idpozo}/{mes}/{idareapermisoconcesion}/{idempresa}" ; rr:class energia:ShaleProduction ] .

<#TightProduction> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT idpozo, mes, idareapermisoconcesion, idempresa FROM capitulo4.produccion WHERE sub_tipo_recurso = 'TIGHT'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/production/{idpozo}/{mes}/{idareapermisoconcesion}/{idempresa}" ; rr:class energia:TightProduction ] .

<#Well> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.operador_pozo" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/well/{idpozo}" ; rr:class energia:Well ] ;
    rr:predicateObjectMap [ rr:predicate energia:wellId ; rr:objectMap [ rr:column "idpozo" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:wellType ; rr:objectMap [ rr:column "tipo_pozo" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:operator ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] .

<#OperatorLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.operador_pozo" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/operatorlink/{idpozo}" ; rr:class energia:OperatorLink ] ;
    rr:predicateObjectMap [ rr:predicate energia:aboutWell ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/well/{idpozo}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:company ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:registryCompany ; rr:objectMap [ rr:column "empresa_padron" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:column "regla" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/capitulo4> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-operator-rule> ] ] .

<#WellStart> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.inicio_pozo" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/wellstart/{idpozo}" ; rr:class energia:WellStart ] ;
    rr:predicateObjectMap [ rr:predicate energia:aboutWell ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/well/{idpozo}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:startMonth ; rr:objectMap [ rr:column "mes" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:company ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:declaredName ; rr:objectMap [ rr:column "nombre_declarado" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:startWellType ; rr:objectMap [ rr:column "tipo_pozo" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:startFormation ; rr:objectMap [ rr:column "formacion" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:startResource ; rr:objectMap [ rr:column "sub_tipo_recurso" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:gasMonths2to7 ; rr:objectMap [ rr:column "gas_2_7" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:gasFirst12Months ; rr:objectMap [ rr:column "gas_12" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:constant "rige la declaración jurada del primer mes" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/capitulo4> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-operator-rule> ] ] .

# --- Datos de fractura de pozos (Adjunto IV), para Rastro Lab ---

<#Fracturing> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.fractura_pozo" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/fracturing/{idpozo}" ; rr:class energia:Fracturing ] ;
    rr:predicateObjectMap [ rr:predicate energia:aboutWell ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/well/{idpozo}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:lateralLengthM ; rr:objectMap [ rr:column "rama_m" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fracStages ; rr:objectMap [ rr:column "etapas" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:proppantTonnes ; rr:objectMap [ rr:column "arena_tn" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:waterM3 ; rr:objectMap [ rr:column "agua_m3" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:maxPressurePsi ; rr:objectMap [ rr:column "presion_psi" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fracDate ; rr:objectMap [ rr:column "fecha" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:company ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:declaredName ; rr:objectMap [ rr:column "nombre_informado" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:constant "las fracturas informadas hasta el mes en que arrancó el pozo, sumadas" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/fractura> ] ] .

<#OperatorChange> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.cambio_operadora" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/operatorchange/{id_concesion}/{mes}" ; rr:class energia:OperatorChange ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:previousCompany ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{anterior_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:newCompany ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{nueva_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:month ; rr:objectMap [ rr:column "mes" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:oilBefore ; rr:objectMap [ rr:column "petroleo_antes_m3" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:oilAfter ; rr:objectMap [ rr:column "petroleo_despues_m3" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:gasBefore ; rr:objectMap [ rr:column "gas_antes_mm3" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:gasAfter ; rr:objectMap [ rr:column "gas_despues_mm3" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:constant "otra empresa declara la mayor parte, 3 meses seguidos" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/capitulo4> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-operator-change> ] ] .

# --- Empresas: sus nombres en cada fuente ------------------------

<#Company> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.empresa" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ; rr:class energia:Company ] ;
    rr:predicateObjectMap [ rr:predicate energia:name ; rr:objectMap [ rr:column "nombre" ] ] .

<#CompanyName> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT md5(fuente || '|' || nombre) AS id, fuente, nombre, empresa_id, regla, evidencia FROM energia.empresa_nombre" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/companyname/{id}" ; rr:class energia:CompanyName ] ;
    rr:predicateObjectMap [ rr:predicate energia:nameInSource ; rr:objectMap [ rr:column "nombre" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:company ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:column "regla" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:template "https://w3id.org/rastro/source/{fuente}" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-name-rules> ] ] .

# --- Concesiones, socios y venteos (mapas de la Secretaría de Energía) ---

<#Concession> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.concesion" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ; rr:class energia:Concession ] ;
    rr:predicateObjectMap [ rr:predicate energia:concessionId ; rr:objectMap [ rr:column "id_concesion" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:name ; rr:objectMap [ rr:column "nombre" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:operatorOnMap ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{operadora_mapa}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:reportedBy ; rr:objectMap [ rr:column "informante" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] .

<#Stake> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id_concesion, empresa_id, porcentaje, texto, regla FROM energia.participacion" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/stake/{id_concesion}/{empresa_id}" ; rr:class energia:Stake ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:partner ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:percent ; rr:objectMap [ rr:column "porcentaje" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "texto" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:column "regla" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-stake-parsing> ] ] .

<#DetectedVenting> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, fecha, satelite, id_concesion FROM energia.venteo WHERE tipo = 'detectado'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/venting/{id}" ; rr:class energia:DetectedVenting ] ;
    rr:predicateObjectMap [ rr:predicate energia:date ; rr:objectMap [ rr:column "fecha" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:satellite ; rr:objectMap [ rr:column "satelite" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] .

<#DeclaredVenting> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, nombre, id_concesion FROM energia.venteo WHERE tipo = 'declarado'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/venting/{id}" ; rr:class energia:DeclaredVenting ] ;
    rr:predicateObjectMap [ rr:predicate energia:name ; rr:objectMap [ rr:column "nombre" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] .

<#LocationLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, id_concesion, evidencia FROM energia.venteo" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/locationlink/{id}" ; rr:class energia:LocationLink ] ;
    rr:predicateObjectMap [ rr:predicate energia:aboutVenting ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/venting/{id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:constant "punto dentro del contorno" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-point-in-polygon> ] ] .

# --- Gasoductos (ENARGAS), entorno (IGN) e identificador global (GLEIF) ---

<#PipelineLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.concesion_gasoducto" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/pipelinelink/{id_concesion}" ; rr:class energia:PipelineLink ] ;
    rr:predicateObjectMap [ rr:predicate energia:aboutConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:pipeline ; rr:objectMap [ rr:column "gasoducto" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:pipelineOperator ; rr:objectMap [ rr:column "licenciataria" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:distanceKm ; rr:objectMap [ rr:column "distancia_km" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/enargas> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-nearest-pipeline> ] ] .

<#SurroundingsLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.venteo_entorno" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/surroundings/{id}" ; rr:class energia:SurroundingsLink ] ;
    rr:predicateObjectMap [ rr:predicate energia:aboutVenting ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/venting/{id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:nearestTown ; rr:objectMap [ rr:column "localidad" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:province ; rr:objectMap [ rr:column "provincia" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:distanceKm ; rr:objectMap [ rr:column "distancia_km" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:protectedArea ; rr:objectMap [ rr:column "area_protegida" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/ign> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-surroundings> ] ] .

<#LeiLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.empresa_lei" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/leilink/{empresa_id}" ; rr:class energia:LeiLink ] ;
    rr:predicateObjectMap [ rr:predicate energia:company ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:lei ; rr:objectMap [ rr:column "lei" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:legalName ; rr:objectMap [ rr:column "nombre_legal" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:column "regla" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/gleif> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-lei-rule> ] ] .

<#CompanyLei> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.empresa_lei" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ;
    rr:predicateObjectMap [ rr:predicate energia:lei ; rr:objectMap [ rr:column "lei" ] ] .

# --- Estudios ambientales (Secretaría de Energía) ----------------

<#EnvironmentalStudy> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """
        SELECT id, id_estudio, fecha_estudio, tipo_estudio, id_concesion, empresa_id,
               CAST(coalesce(observaciones, nombre_objeto) AS text) AS texto
        FROM energia.estudio""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/study/{id}" ; rr:class energia:EnvironmentalStudy ] ;
    rr:predicateObjectMap [ rr:predicate energia:studyId ; rr:objectMap [ rr:column "id_estudio" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:date ; rr:objectMap [ rr:column "fecha_estudio" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:studyType ; rr:objectMap [ rr:column "tipo_estudio" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "texto" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:company ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/company/{empresa_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/ambiental> ] ] .

<#StudyLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, id_concesion, evidencia FROM energia.estudio WHERE id_concesion IS NOT NULL" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/studylink/{id}" ; rr:class energia:StudyLink ] ;
    rr:predicateObjectMap [ rr:predicate energia:aboutStudy ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/study/{id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:inConcession ; rr:objectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:rule ; rr:objectMap [ rr:constant "mismo nombre de concesión" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:sourceText ; rr:objectMap [ rr:column "evidencia" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/ambiental> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/sig_energia> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/energia-study-names> ] ] .

# --- Geometrías (GeoSPARQL) y concesiones para revisar ------------

<#ConcessionGeometry> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id_concesion, wkt FROM energia.concesion WHERE wkt IS NOT NULL" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ] ;
    rr:predicateObjectMap [ rr:predicate geo:asWKT ; rr:objectMap [ rr:column "wkt" ; rr:datatype geo:wktLiteral ] ] .

<#VentingGeometry> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, wkt FROM energia.venteo" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/venting/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate geo:asWKT ; rr:objectMap [ rr:column "wkt" ; rr:datatype geo:wktLiteral ] ] .

<#Pipeline> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "energia.gasoducto" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/pipeline/{id}" ; rr:class energia:Pipeline ] ;
    rr:predicateObjectMap [ rr:predicate energia:name ; rr:objectMap [ rr:column "nombre" ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:pipelineOperator ; rr:objectMap [ rr:column "licenciataria" ] ] ;
    rr:predicateObjectMap [ rr:predicate geo:asWKT ; rr:objectMap [ rr:column "wkt" ; rr:datatype geo:wktLiteral ] ] ;
    rr:predicateObjectMap [ rr:predicate energia:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/enargas> ] ] .

<#VentingFarFromPipeline> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id_concesion, evidencia FROM energia.concesion_revisar WHERE motivo = 'sin gasoducto cerca'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ; rr:class energia:VentingFarFromPipeline ] ;
    rr:predicateObjectMap [ rr:predicate energia:reviewReason ; rr:objectMap [ rr:column "evidencia" ] ] .

<#VentingWithoutReports> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id_concesion, evidencia FROM energia.concesion_revisar WHERE motivo = 'sin planillas de venteo'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/energia/concession/{id_concesion}" ; rr:class energia:VentingWithoutReports ] ;
    rr:predicateObjectMap [ rr:predicate energia:reviewReason ; rr:objectMap [ rr:column "evidencia" ] ] .
