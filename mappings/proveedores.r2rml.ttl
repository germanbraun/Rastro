# Mapeos R2RML del dominio de proveedores: cómo se leen las tablas de Postgres como grafo.
# Los lee el segundo Ontop (ontop-proveedores, puerto 8081). Una sección por fuente.
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix proveedores: <https://w3id.org/rastro/proveedores#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- Fuentes (rastro_meta) -------------------------------------

<#DataSource> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """
        SELECT id, name, license FROM rastro_meta.source
        WHERE id IN ('usaspending', 'naics', 'csl', 'gleif', 'wikidata')""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/source/{id}" ; rr:class proveedores:DataSource ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:name ; rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:license ; rr:objectMap [ rr:column "license" ] ] .

# --- Contratos, proveedores, grupos y agencias (USAspending) ----

<#Contract> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """
        SELECT generated_internal_id, award_id, recipient_uei, awarding_agency, awarding_sub_agency,
               naics_code, amount, start_date, end_date, description
        FROM usaspending.contract""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/contract/{generated_internal_id}" ; rr:class proveedores:Contract ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:contractId ; rr:objectMap [ rr:column "award_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:amount ; rr:objectMap [ rr:column "amount" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:startDate ; rr:objectMap [ rr:column "start_date" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:endDate ; rr:objectMap [ rr:column "end_date" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:description ; rr:objectMap [ rr:column "description" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:subAgency ; rr:objectMap [ rr:column "awarding_sub_agency" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:supplier ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{recipient_uei}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:agency ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/agency/{awarding_agency}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:sector ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/sector/{naics_code}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] .

<#Supplier> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.supplier" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{uei}" ; rr:class proveedores:Supplier ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:name ; rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:uei ; rr:objectMap [ rr:column "uei" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:state ; rr:objectMap [ rr:column "state_code" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] .

<#Group> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.group_company" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{group_id}" ; rr:class proveedores:Group ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:name ; rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:uei ; rr:objectMap [ rr:column "uei" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] .

<#SupplierGroup> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.supplier_group" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{supplier_uei}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:group ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{group_id}" ] ] .

# Por qué un proveedor es parte de un grupo, con PROV-O
<#GroupLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.supplier_group" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/link/group/{supplier_uei}" ; rr:class proveedores:GroupLink ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkFrom ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{supplier_uei}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkTo ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{group_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:sourceText ; rr:objectMap [ rr:column "source_text" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:matchedText ; rr:objectMap [ rr:column "matched" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkRule ; rr:objectMap [ rr:column "rule" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] .

<#Agency> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.agency" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/agency/{name}" ; rr:class proveedores:Agency ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:name ; rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] .

# --- Sectores (NAICS) --------------------------------------------

# NAICS 2022 más los códigos viejos que usan algunos contratos (linking/proveedores/entities.sql)
<#Sector> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.sector" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/sector/{code}" ; rr:class proveedores:Sector ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:code ; rr:objectMap [ rr:column "code" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:name ; rr:objectMap [ rr:column "title" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/naics> ] ] .

# Cada sector está dentro de sí mismo y de sus sectores más amplios (precalculado)
<#SectorWithin> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.sector_ancestor" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/sector/{code}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:within ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/sector/{ancestor_code}" ] ] .

# --- Entidades legales (GLEIF) -----------------------------------

<#LegalEntity> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT lei, legal_name, country FROM gleif.lei_record" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/lei/{lei}" ; rr:class proveedores:LegalEntity ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:lei ; rr:objectMap [ rr:column "lei" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:name ; rr:objectMap [ rr:column "legal_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:country ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/country/{country}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/gleif> ] ] .

# Matriz final según GLEIF; si no registra una, la entidad es su propia matriz final (precalculado)
<#UltimateParent> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.lei_final_parent" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/lei/{lei}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:ultimateParent ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/lei/{final_lei}" ] ] .

<#Country> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.country" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/country/{code}" ; rr:class proveedores:Country ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:code ; rr:objectMap [ rr:column "code" ] ] .

# --- Enlaces con LEI (linking/proveedores/links.sql) --------------

<#SupplierLei> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT uei, lei FROM proveedores.lei_link WHERE kind = 'supplier'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{uei}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:legalEntity ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/lei/{lei}" ] ] .

# El LEI de un grupo consolidado es su matriz final en GLEIF
<#GroupLei> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT group_id, lei FROM proveedores.group_company WHERE lei IS NOT NULL" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{group_id}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:legalEntity ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/lei/{lei}" ] ] .

<#SupplierLeiLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT uei, lei, matched_text, source_text, rule FROM proveedores.lei_link WHERE kind = 'supplier'""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/link/lei/supplier/{uei}" ; rr:class proveedores:LeiLink ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkFrom ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{uei}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkTo ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/lei/{lei}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:sourceText ; rr:objectMap [ rr:column "source_text" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:matchedText ; rr:objectMap [ rr:column "matched_text" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkRule ; rr:objectMap [ rr:column "rule" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/gleif> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/entity-linking> ] ] .

# --- Listas de control (Lista Consolidada) -------------------------

<#WatchlistEntry> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, source, type, name FROM csl.entry" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/watchlist/{source}/{id}" ; rr:class proveedores:WatchlistEntry ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:name ; rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:list ; rr:objectMap [ rr:column "source" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:entryType ; rr:objectMap [ rr:column "type" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:fromSource ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/csl> ] ] .

<#WatchlistAlias> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.watchlist_alias" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/watchlist/{source}/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:alias ; rr:objectMap [ rr:column "alias" ] ] .

<#SupplierWatchlist> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT uei, entry_id, entry_source FROM proveedores.watchlist_link WHERE kind = 'supplier'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{uei}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:watchlistMatch ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/watchlist/{entry_source}/{entry_id}" ] ] .

<#GroupWatchlist> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT uei, entry_id, entry_source FROM proveedores.watchlist_link WHERE kind = 'group'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{uei}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:watchlistMatch ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/watchlist/{entry_source}/{entry_id}" ] ] .

<#SupplierWatchlistLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT uei, entry_id, entry_source, matched_text, source_text, rule FROM proveedores.watchlist_link WHERE kind = 'supplier'""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/link/watchlist/supplier/{uei}/{entry_source}/{entry_id}" ; rr:class proveedores:WatchlistLink ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkFrom ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{uei}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkTo ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/watchlist/{entry_source}/{entry_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:sourceText ; rr:objectMap [ rr:column "source_text" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:matchedText ; rr:objectMap [ rr:column "matched_text" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkRule ; rr:objectMap [ rr:column "rule" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/csl> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/entity-linking> ] ] .

<#GroupWatchlistLink> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT uei, entry_id, entry_source, matched_text, source_text, rule FROM proveedores.watchlist_link WHERE kind = 'group'""" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/link/watchlist/group/{uei}/{entry_source}/{entry_id}" ; rr:class proveedores:WatchlistLink ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkFrom ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{uei}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkTo ; rr:objectMap [ rr:template "https://w3id.org/rastro/proveedores/watchlist/{entry_source}/{entry_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:sourceText ; rr:objectMap [ rr:column "source_text" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:matchedText ; rr:objectMap [ rr:column "matched_text" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:linkRule ; rr:objectMap [ rr:column "rule" ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/usaspending> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasDerivedFrom ; rr:objectMap [ rr:constant <https://w3id.org/rastro/source/csl> ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:wasGeneratedBy ; rr:objectMap [ rr:constant <https://w3id.org/rastro/activity/entity-linking> ] ] .

# --- Grupo → Wikidata, por LEI --------------------------------------

<#GroupWikidata> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "proveedores.group_wikidata" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{group_id}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:wikidataId ; rr:objectMap [ rr:column "qid" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:listed ; rr:objectMap [ rr:column "listed" ] ] .

<#GroupWikidataDetails> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT group_id, exchanges, headquarters FROM proveedores.group_wikidata" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/group/{group_id}" ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:stockExchange ; rr:objectMap [ rr:column "exchanges" ] ] ;
    rr:predicateObjectMap [ rr:predicate proveedores:headquarters ; rr:objectMap [ rr:column "headquarters" ] ] .

# --- Proveedores para revisar ----------------------------------------
# Solo se mapean las dos subclases. «Proveedor para revisar» no tiene mapeo: Ontop lo
# deduce de la ontología (rdfs:subClassOf).
<#ForeignParentSupplier> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT uei FROM proveedores.supplier_flag WHERE flag = 'ForeignParent'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{uei}" ; rr:class proveedores:ForeignParentSupplier ] .

<#WatchlistSupplier> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT uei FROM proveedores.supplier_flag WHERE flag = 'Watchlist'" ] ;
    rr:subjectMap [ rr:template "https://w3id.org/rastro/proveedores/supplier/{uei}" ; rr:class proveedores:WatchlistSupplier ] .
