[PrefixDeclaration]
:		https://w3id.org/rastro/ontology#
src:		https://w3id.org/rastro/source/
rdfs:		http://www.w3.org/2000/01/rdf-schema#
xsd:		http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[
mappingId	rastro-meta-source
target		src:{id} a :DataSource ; rdfs:label {name}^^xsd:string ; :homepage {homepage}^^xsd:anyURI ; :license {license}^^xsd:string .
source		SELECT id, name, homepage, license FROM rastro_meta.source
]]
