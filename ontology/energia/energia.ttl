@prefix energia: <https://w3id.org/rastro/energia#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .

<https://w3id.org/rastro/energia> a owl:Ontology ;
    rdfs:label "Diccionario de negocio: petróleo y gas en Argentina"@es ;
    rdfs:comment """Lo mínimo para responder las preguntas de ontology/energia/competency-questions.md:
la producción de 2025 pozo por pozo, las concesiones con sus socios, quién opera cada pozo y los
venteos de gas, con los gasoductos de transporte (ENARGAS), las localidades y áreas protegidas (IGN)
y el identificador global de las empresas (GLEIF), y los cambios de operadora de cada concesión
entre 2023 y 2025. Cada enlace entre fuentes lleva su evidencia, con PROV-O. «Producción no
convencional» no tiene mapeo: Ontop la deduce de sus subclases (shale y tight)."""@es ;
    owl:versionInfo "0.6" .

# Clases ---------------------------------------------------------

energia:DataSource a owl:Class ;
    rdfs:label "Fuente de datos"@es .

energia:Company a owl:Class ;
    rdfs:label "Empresa"@es ;
    rdfs:comment "Una empresa, con todos los nombres con que aparece en las fuentes. Si una corrección revisada lo dice, varias razones sociales son un mismo grupo (por ejemplo, Chevron)."@es .

energia:Concession a owl:Class ;
    rdfs:label "Concesión"@es ;
    rdfs:comment "Un área de explotación de hidrocarburos, con su contorno en el mapa de la Secretaría de Energía."@es .

energia:Well a owl:Class ;
    rdfs:label "Pozo"@es ;
    rdfs:comment "Un pozo que declaró producción en 2025."@es .

energia:WellProduction a owl:Class ;
    rdfs:label "Producción de un pozo"@es ;
    rdfs:comment "Lo que produjo un pozo en 2025 desde una formación, según las declaraciones juradas mensuales (Capítulo IV)."@es .

energia:UnconventionalProduction a owl:Class ;
    rdfs:subClassOf energia:WellProduction ;
    rdfs:label "Producción no convencional"@es ;
    rdfs:comment "Producción de shale o de tight. Ningún mapeo la asigna: se deduce de sus subclases."@es .

energia:ShaleProduction a owl:Class ;
    rdfs:subClassOf energia:UnconventionalProduction ;
    rdfs:label "Producción de shale"@es .

energia:TightProduction a owl:Class ;
    rdfs:subClassOf energia:UnconventionalProduction ;
    rdfs:label "Producción de tight"@es .

energia:Stake a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Participación"@es ;
    rdfs:comment "La parte de una empresa en una concesión, separada del texto de socios del mapa. Su evidencia es ese texto."@es .

energia:OperatorLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Operadora de un pozo"@es ;
    rdfs:comment "Quién opera hoy un pozo y por qué: la empresa que declara su producción del último mes. Si el padrón de pozos dice otra cosa, queda a la vista."@es .

energia:CompanyName a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Nombre de una empresa en una fuente"@es ;
    rdfs:comment "Cómo aparece una empresa en una fuente, y por qué Rastro sabe que es esa empresa."@es .

energia:LocationLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Ubicación de un venteo"@es ;
    rdfs:comment "En qué concesión cae un venteo y por qué: el punto está dentro del contorno de la concesión en el mapa."@es .

energia:PipelineLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Gasoducto más cercano"@es ;
    rdfs:comment "El gasoducto de transporte de ENARGAS más cercano al contorno de una concesión, y a cuántos km. 0 km si lo cruza."@es .

energia:SurroundingsLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Entorno de un venteo"@es ;
    rdfs:comment "La localidad más cercana a un posible venteo y si cae dentro de un área protegida, según el IGN."@es .

energia:LeiLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Identificador global de una empresa"@es ;
    rdfs:comment "El LEI de una empresa en GLEIF: se acepta si su nombre legal, normalizado, es igual. Guarda lo descartado."@es .

energia:Venting a owl:Class ;
    rdfs:label "Venteo"@es ;
    rdfs:comment "Un punto donde se ventea o se quema gas, ubicado dentro de una concesión."@es .

energia:DetectedVenting a owl:Class ;
    rdfs:subClassOf energia:Venting ;
    rdfs:label "Posible venteo detectado por satélite"@es ;
    rdfs:comment "Una anomalía térmica que un satélite vio desde 2024. Es un indicio, no una confirmación."@es .

energia:DeclaredVenting a owl:Class ;
    rdfs:subClassOf energia:Venting ;
    rdfs:label "Punto de venteo declarado"@es ;
    rdfs:comment "Una chimenea o fosa de quema que la empresa declaró (RES. 319/93)."@es .

# Propiedades ----------------------------------------------------

energia:name a owl:DatatypeProperty ; rdfs:label "nombre"@es .
energia:license a owl:DatatypeProperty ; rdfs:domain energia:DataSource ; rdfs:label "licencia"@es .
energia:fromSource a owl:ObjectProperty ; rdfs:range energia:DataSource ; rdfs:label "viene de"@es .

energia:concessionId a owl:DatatypeProperty ; rdfs:domain energia:Concession ; rdfs:label "código de la concesión"@es .
energia:operatorOnMap a owl:ObjectProperty ; rdfs:domain energia:Concession ; rdfs:range energia:Company ;
    rdfs:label "operadora según el mapa"@es .
energia:reportedBy a owl:DatatypeProperty ; rdfs:domain energia:Concession ;
    rdfs:label "informó el mapa"@es ;
    rdfs:comment "La empresa que informó el contorno al mapa. Puede no ser la operadora de hoy."@es .

energia:wellId a owl:DatatypeProperty ; rdfs:label "identificador del pozo"@es .
energia:well a owl:ObjectProperty ; rdfs:domain energia:WellProduction ; rdfs:range energia:Well ; rdfs:label "pozo"@es .
energia:declaredBy a owl:ObjectProperty ; rdfs:domain energia:WellProduction ; rdfs:range energia:Company ;
    rdfs:label "la declara"@es .
energia:formation a owl:DatatypeProperty ; rdfs:domain energia:WellProduction ; rdfs:label "formación"@es ;
    rdfs:comment "La formación productiva, en minúsculas: «vaca muerta», «comodoro rivadavia»…"@es .
energia:basin a owl:DatatypeProperty ; rdfs:label "cuenca"@es .
energia:province a owl:DatatypeProperty ; rdfs:label "provincia"@es .
energia:oil a owl:DatatypeProperty ; rdfs:domain energia:WellProduction ; rdfs:label "petróleo (m³)"@es .
energia:gas a owl:DatatypeProperty ; rdfs:domain energia:WellProduction ; rdfs:label "gas (miles de m³)"@es .

energia:operator a owl:ObjectProperty ; rdfs:domain energia:Well ; rdfs:range energia:Company ;
    rdfs:label "operadora hoy"@es .

energia:inConcession a owl:ObjectProperty ; rdfs:range energia:Concession ; rdfs:label "en la concesión"@es ;
    rdfs:comment "La concesión donde está: la producción de un pozo (energia:WellProduction), la participación de una empresa (energia:Stake), un venteo, un enlace o un estudio ambiental. Es la única propiedad que une algo con su concesión."@es .
energia:partner a owl:ObjectProperty ; rdfs:domain energia:Stake ; rdfs:range energia:Company ; rdfs:label "socia"@es .
energia:percent a owl:DatatypeProperty ; rdfs:domain energia:Stake ; rdfs:label "porcentaje"@es .

energia:aboutWell a owl:ObjectProperty ; rdfs:domain energia:OperatorLink ; rdfs:range energia:Well ; rdfs:label "sobre el pozo"@es .
energia:company a owl:ObjectProperty ; rdfs:range energia:Company ; rdfs:label "empresa"@es .
energia:registryCompany a owl:DatatypeProperty ; rdfs:domain energia:OperatorLink ;
    rdfs:label "empresa según el padrón"@es .
energia:nameInSource a owl:DatatypeProperty ; rdfs:domain energia:CompanyName ; rdfs:label "nombre en la fuente"@es .
energia:rule a owl:DatatypeProperty ; rdfs:label "regla"@es .
energia:sourceText a owl:DatatypeProperty ; rdfs:label "evidencia"@es .

energia:aboutVenting a owl:ObjectProperty ; rdfs:domain energia:LocationLink ; rdfs:range energia:Venting ; rdfs:label "sobre el venteo"@es .
energia:aboutConcession a owl:ObjectProperty ; rdfs:range energia:Concession ; rdfs:label "sobre la concesión"@es .
energia:pipeline a owl:DatatypeProperty ; rdfs:domain energia:PipelineLink ; rdfs:label "gasoducto"@es .
energia:pipelineOperator a owl:DatatypeProperty ; rdfs:label "licenciataria del gasoducto"@es .   # sin dominio: lo usan el gasoducto y el enlace
energia:distanceKm a owl:DatatypeProperty ; rdfs:label "distancia (km)"@es .
energia:nearestTown a owl:DatatypeProperty ; rdfs:domain energia:SurroundingsLink ; rdfs:label "localidad más cercana"@es .
energia:protectedArea a owl:DatatypeProperty ; rdfs:domain energia:SurroundingsLink ; rdfs:label "área protegida"@es .
energia:lei a owl:DatatypeProperty ; rdfs:label "LEI"@es .
energia:legalName a owl:DatatypeProperty ; rdfs:domain energia:LeiLink ; rdfs:label "nombre legal en GLEIF"@es .
energia:date a owl:DatatypeProperty ; rdfs:domain energia:Venting ; rdfs:label "fecha"@es .
energia:satellite a owl:DatatypeProperty ; rdfs:domain energia:DetectedVenting ; rdfs:label "satélite"@es .

energia:EnvironmentalStudy a owl:Class ;
    rdfs:label "Estudio ambiental"@es ;
    rdfs:comment "Un estudio o informe ambiental que presentó una empresa (monitoreo, abandono de pozos, planillas de venteo de gas…), según el listado de la Secretaría de Energía."@es .

energia:StudyLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Concesión de un estudio ambiental"@es ;
    rdfs:comment "A qué concesión del mapa corresponde un estudio: el listado nombra la concesión como texto, y se une si el nombre coincide."@es .

energia:studyId a owl:DatatypeProperty ; rdfs:domain energia:EnvironmentalStudy ; rdfs:label "número del estudio"@es .
energia:studyType a owl:DatatypeProperty ; rdfs:domain energia:EnvironmentalStudy ; rdfs:label "tipo de estudio"@es .
energia:aboutStudy a owl:ObjectProperty ; rdfs:domain energia:StudyLink ; rdfs:range energia:EnvironmentalStudy ; rdfs:label "sobre el estudio"@es .

# Geometrías (GeoSPARQL, el estándar de OGC) y la regla «concesión para revisar» ---------

energia:Pipeline a owl:Class ;
    rdfs:label "Gasoducto de transporte"@es ;
    rdfs:comment "Un tramo de gasoducto de transporte de gas, según ENARGAS."@es .

energia:ConcessionToReview a owl:Class ;
    rdfs:subClassOf energia:Concession ;
    rdfs:label "Concesión para revisar"@es ;
    rdfs:comment "Una concesión que conviene mirar: tiene posibles venteos vistos por satélite y además no tiene un gasoducto de transporte cerca, o no presentó planillas de venteo de gas. Ningún mapeo la asigna: se deduce de sus subclases."@es .

energia:VentingFarFromPipeline a owl:Class ;
    rdfs:subClassOf energia:ConcessionToReview ;
    rdfs:label "Con venteos y sin gasoducto cerca"@es ;
    rdfs:comment "Posibles venteos desde 2024 y el gasoducto de transporte más cercano a 10 km o más."@es .

energia:VentingWithoutReports a owl:Class ;
    rdfs:subClassOf energia:ConcessionToReview ;
    rdfs:label "Con venteos y sin planillas de venteo"@es ;
    rdfs:comment "Al menos 20 posibles venteos desde 2024 y ninguna planilla de venteo de gas (Res. 143/98) presentada desde 2022."@es .

energia:reviewReason a owl:DatatypeProperty ; rdfs:domain energia:ConcessionToReview ; rdfs:label "motivo para revisar"@es .
geo:asWKT a owl:DatatypeProperty ; rdfs:label "geometría (WKT)"@es ;
    rdfs:comment "El contorno, el punto o el trazado, en WKT: el estándar de OGC que leen GeoSPARQL y las herramientas de mapas."@es .

# Cambios de operadora (2023 a 2025) -------------------------------

energia:OperatorChange a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Cambio de operadora"@es ;
    rdfs:comment "Una concesión pasa a otra operadora: desde ese mes, otra empresa declara la mayor parte de su producción, al menos 3 meses seguidos. Un mes sin producción cuenta si lo declara una sola empresa. Guarda lo que producía la concesión por mes, en promedio, antes y después."@es .

energia:previousCompany a owl:ObjectProperty ; rdfs:domain energia:OperatorChange ; rdfs:range energia:Company ; rdfs:label "operadora anterior"@es .
energia:newCompany a owl:ObjectProperty ; rdfs:domain energia:OperatorChange ; rdfs:range energia:Company ; rdfs:label "operadora nueva"@es .
energia:month a owl:DatatypeProperty ; rdfs:domain energia:OperatorChange ; rdfs:label "desde el mes"@es ;
    rdfs:comment "El primer día del primer mes con la operadora nueva."@es .
energia:oilBefore a owl:DatatypeProperty ; rdfs:domain energia:OperatorChange ; rdfs:label "petróleo por mes antes (m³)"@es .
energia:oilAfter a owl:DatatypeProperty ; rdfs:domain energia:OperatorChange ; rdfs:label "petróleo por mes después (m³)"@es .
energia:gasBefore a owl:DatatypeProperty ; rdfs:domain energia:OperatorChange ; rdfs:label "gas por mes antes (miles de m³)"@es .
energia:gasAfter a owl:DatatypeProperty ; rdfs:domain energia:OperatorChange ; rdfs:label "gas por mes después (miles de m³)"@es .
