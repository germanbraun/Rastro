# 3. ¿En qué concesiones vio el satélite más posibles venteos desde 2024, quién las opera y cuántos puntos de venteo declararon?
PREFIX energia: <https://w3id.org/rastro/energia#>

SELECT ?concession ?operator (COUNT(DISTINCT ?d) AS ?detected) (COUNT(DISTINCT ?v) AS ?declared)
WHERE {
  ?d a energia:DetectedVenting ; energia:inConcession ?c .
  ?c energia:name ?concession ; energia:operatorOnMap/energia:name ?operator .
  OPTIONAL { ?v a energia:DeclaredVenting ; energia:inConcession ?c }
}
GROUP BY ?concession ?operator
ORDER BY DESC(?detected)
LIMIT 10
