# 5. ¿Qué concesiones con posibles venteos tienen el gasoducto de transporte más cercano a 10 km o más?
PREFIX energia: <https://w3id.org/rastro/energia#>

SELECT ?concession ?operator (COUNT(DISTINCT ?d) AS ?detected) ?distanceKm ?pipeline
WHERE {
  ?d a energia:DetectedVenting ; energia:inConcession ?c .
  ?c energia:name ?concession ; energia:operatorOnMap/energia:name ?operator .
  ?g a energia:PipelineLink ; energia:aboutConcession ?c ; energia:distanceKm ?distanceKm ; energia:pipeline ?pipeline .
  FILTER (?distanceKm >= 10)
}
GROUP BY ?concession ?operator ?distanceKm ?pipeline
ORDER BY DESC(?detected)
LIMIT 10
