# 6. ¿Qué posibles venteos caen dentro de un área protegida o a menos de 3 km de una localidad?
PREFIX energia: <https://w3id.org/rastro/energia#>

SELECT ?concession ?operator ?place (COUNT(DISTINCT ?d) AS ?detected)
WHERE {
  ?d a energia:DetectedVenting ; energia:inConcession ?c .
  ?c energia:name ?concession ; energia:operatorOnMap/energia:name ?operator .
  ?s a energia:SurroundingsLink ; energia:aboutVenting ?d ; energia:nearestTown ?town ; energia:distanceKm ?km .
  OPTIONAL { ?s energia:protectedArea ?area }
  FILTER (BOUND(?area) || ?km < 3)
  BIND (IF(BOUND(?area), CONCAT("área protegida: ", ?area), CONCAT("cerca de ", ?town)) AS ?place)
}
GROUP BY ?concession ?operator ?place
ORDER BY DESC(?detected)
LIMIT 10
