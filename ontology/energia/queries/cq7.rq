# 7. ¿Qué empresas que producen en Argentina tienen identificador global (LEI) en GLEIF?
PREFIX energia: <https://w3id.org/rastro/energia#>

SELECT ?company ?lei (SUM(?oil) AS ?operated)
WHERE {
  ?e energia:name ?company ; energia:lei ?lei .
  ?p energia:declaredBy ?e ; energia:oil ?oil .
}
GROUP BY ?company ?lei
ORDER BY DESC(?operated)
