# 3. ¿Qué agencias concentran más de un tercio de su gasto en un solo grupo?
PREFIX : <https://w3id.org/rastro/proveedores#>

SELECT ?agency ?group ?groupTotal ?agencyTotal ?share
WHERE {
  { SELECT ?ag (SUM(?a) AS ?agencyTotal)
    WHERE { ?c :agency ?ag ; :amount ?a } GROUP BY ?ag }
  { SELECT ?ag ?g (SUM(?b) AS ?groupTotal)
    WHERE { ?d :agency ?ag ; :amount ?b ; :supplier/:group ?g } GROUP BY ?ag ?g }
  BIND (?groupTotal / ?agencyTotal AS ?share)
  FILTER (?share > 1.0 / 3)
  ?ag :name ?agency .
  ?g :name ?group .
}
ORDER BY DESC(?share)
