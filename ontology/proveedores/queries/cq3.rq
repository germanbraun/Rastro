# 3. ¿Qué agencias concentran más de un tercio de su gasto en un solo grupo?
PREFIX proveedores: <https://w3id.org/rastro/proveedores#>

SELECT ?agency ?group ?groupTotal ?agencyTotal ?share
WHERE {
  { SELECT ?ag (SUM(?a) AS ?agencyTotal)
    WHERE { ?c proveedores:agency ?ag ; proveedores:amount ?a } GROUP BY ?ag }
  { SELECT ?ag ?g (SUM(?b) AS ?groupTotal)
    WHERE { ?d proveedores:agency ?ag ; proveedores:amount ?b ; proveedores:supplier/proveedores:group ?g } GROUP BY ?ag ?g }
  BIND (?groupTotal / ?agencyTotal AS ?share)
  FILTER (?share > 1.0 / 3)
  ?ag proveedores:name ?agency .
  ?g proveedores:name ?group .
}
ORDER BY DESC(?share)
