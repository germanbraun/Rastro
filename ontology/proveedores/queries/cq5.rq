# 5. ¿Algún proveedor, o su grupo, aparece en una lista de control del gobierno?
PREFIX proveedores: <https://w3id.org/rastro/proveedores#>

SELECT ?who ?name ?entry ?list ?matched ?rule
WHERE {
  { ?x a proveedores:Supplier . BIND ("proveedor" AS ?who) }
  UNION
  { ?x a proveedores:Group . BIND ("grupo" AS ?who) }
  ?x proveedores:name ?name .
  ?link a proveedores:WatchlistLink ; proveedores:linkFrom ?x ; proveedores:linkTo ?e ; proveedores:matchedText ?matched ; proveedores:linkRule ?rule .
  ?e proveedores:name ?entry ; proveedores:list ?list .
}
ORDER BY ?name
