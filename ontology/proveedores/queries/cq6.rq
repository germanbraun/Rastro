# 6. ¿Cuántos proveedores distintos tiene el Departamento de Defensa en construcción?
PREFIX proveedores: <https://w3id.org/rastro/proveedores#>

SELECT (COUNT(DISTINCT ?s) AS ?suppliers) (COUNT(?contract) AS ?contracts) (SUM(?amount) AS ?total)
WHERE {
  ?dod proveedores:name "Department of Defense" .
  # 23: Construction, y todos sus subsectores
  ?construction proveedores:code "23" .
  ?contract proveedores:agency ?dod ; proveedores:sector/proveedores:within ?construction ; proveedores:supplier ?s ; proveedores:amount ?amount .
}
