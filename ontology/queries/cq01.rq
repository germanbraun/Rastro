# CQ01. ¿Qué fármacos con target HER2 (ERBB2) están en ensayos de fase 3 para cáncer
# de mama, y quién los patrocina?
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?drugName ?nctId ?title ?sponsorName ?statusLabel
WHERE {
  ?target :geneSymbol "ERBB2" .
  ?drug :hasTarget ?target ;
        rdfs:label ?drugName .

  ?trial :testsDrug ?drug ;
         :nctId ?nctId ;
         :title ?title ;
         :phase/:includesPhase :Phase3 ;
         :status/rdfs:label ?statusLabel ;
         :leadSponsor/rdfs:label ?sponsorName ;
         :studiesCondition ?condition .

  # Cáncer de mama y cualquier descriptor más específico
  ?breast rdfs:label "Breast Neoplasms"@en .
  ?condition meshv:broaderDescriptor* ?breast .
}
ORDER BY ?drugName ?nctId
