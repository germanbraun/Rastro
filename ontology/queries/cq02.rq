# CQ02. Para un target dado (por ejemplo EGFR), ¿cuántos ensayos hay por fase y por estado?
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?phaseLabel ?statusLabel (COUNT(DISTINCT ?trial) AS ?trials)
WHERE {
  VALUES ?gene { "EGFR" }
  ?target :geneSymbol ?gene .
  ?drug :hasTarget ?target .
  ?trial :testsDrug ?drug ;
         :phase/rdfs:label ?phaseLabel ;
         :status/rdfs:label ?statusLabel .
}
GROUP BY ?phaseLabel ?statusLabel
ORDER BY ?phaseLabel DESC(?trials)
