# CQ03. ¿Qué sponsors de la industria tienen más ensayos terminados o retirados en
# cáncer de pulmón, y qué motivos declaran?
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?sponsorName (COUNT(DISTINCT ?trial) AS ?stoppedTrials)
       (GROUP_CONCAT(DISTINCT ?why; separator=" | ") AS ?reasons)
WHERE {
  ?trial :leadSponsor ?sponsor ;
         :status/a :StoppedEarlyStatus ;
         :studiesCondition ?condition .
  ?sponsor :agencyClass "INDUSTRY" ;
           rdfs:label ?sponsorName .
  OPTIONAL { ?trial :whyStopped ?why }

  # Incluye NSCLC, SCLC y demás descriptores bajo Lung Neoplasms
  ?lung rdfs:label "Lung Neoplasms"@en .
  ?condition meshv:broaderDescriptor* ?lung .
}
GROUP BY ?sponsorName
ORDER BY DESC(?stoppedTrials)
LIMIT 20
