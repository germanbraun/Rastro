# CQ04. ¿Qué condiciones, agrupadas por la jerarquía de MeSH, concentran más ensayos con
# inhibidores de PD-1 o PD-L1?
# Agrupa al nivel de los hijos de "Neoplasms by Site" (por ejemplo, Thoracic Neoplasms).
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?groupName (COUNT(DISTINCT ?trial) AS ?trials)
WHERE {
  VALUES ?gene { "PDCD1" "CD274" }
  ?target :geneSymbol ?gene .
  ?drug :hasTarget ?target .
  ?trial :testsDrug ?drug ;
         :studiesCondition ?condition .

  ?bySite rdfs:label "Neoplasms by Site"@en .
  ?group meshv:broaderDescriptor ?bySite ;
         rdfs:label ?groupName .
  ?condition meshv:broaderDescriptor* ?group .
}
GROUP BY ?groupName
ORDER BY DESC(?trials)
