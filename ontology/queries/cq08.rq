# CQ08. ¿Qué targets tienen fármacos en ensayos activos pero ningún fármaco aprobado?
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?targetName ?gene (COUNT(DISTINCT ?trial) AS ?activeTrials)
       (COUNT(DISTINCT ?drug) AS ?drugsInTrials)
WHERE {
  ?drug :hasTarget ?target .
  ?trial :testsDrug ?drug ;
         :status/a :ActiveStatus .
  ?target rdfs:label ?targetName .
  OPTIONAL { ?target :geneSymbol ?gene }

  FILTER NOT EXISTS {
    ?approved :hasTarget ?target ;
              :maxPhase ?phase .
    FILTER (?phase >= 4)
  }
}
GROUP BY ?targetName ?gene
ORDER BY DESC(?activeTrials)
LIMIT 30
