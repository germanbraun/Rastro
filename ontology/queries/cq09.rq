# CQ09. Para un ensayo dado, ¿cuántos reportes de eventos adversos (totales, serios y con
# muerte) acumulaban sus fármacos antes del año de inicio del ensayo?
# Solo años estrictamente anteriores al inicio: no se usan datos posteriores (fuga de
# información en Rastro Lab).
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?drugName ?startYear
       (SUM(?reports) AS ?priorReports) (SUM(?serious) AS ?priorSerious) (SUM(?deaths) AS ?priorDeaths)
WHERE {
  VALUES ?nctId { "NCT00000000" }   # parámetro
  ?trial :nctId ?nctId ;
         :startDate ?start ;
         :testsDrug ?drug .
  ?drug rdfs:label ?drugName .
  BIND (YEAR(?start) AS ?startYear)

  OPTIONAL {
    ?summary :summaryOf ?drug ;
             :year ?year ;
             :reportCount ?reports ;
             :seriousCount ?serious ;
             :deathCount ?deaths .
    FILTER (YEAR(?year) < ?startYear)
  }
}
GROUP BY ?drugName ?startYear
