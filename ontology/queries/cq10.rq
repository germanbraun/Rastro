# CQ10. Para un sponsor, ¿qué proporción de sus ensayos de fase 2 cerrados terminaron antes
# de tiempo, por gran área de MeSH?
# Área = hijos de "Neoplasms by Site". Cerrados = completados, terminados o retirados.
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?areaName (COUNT(DISTINCT ?trial) AS ?closedTrials)
       (COUNT(DISTINCT ?stopped) AS ?stoppedTrials)
       (COUNT(DISTINCT ?stopped) / COUNT(DISTINCT ?trial) AS ?stoppedRatio)
WHERE {
  VALUES ?sponsorName { "Pfizer" }   # parámetro
  ?sponsor rdfs:label ?sponsorName .
  ?trial :leadSponsor ?sponsor ;
         :phase/:includesPhase :Phase2 ;
         :status ?status ;
         :studiesCondition ?condition .
  ?status a :ClosedStatus .
  OPTIONAL { ?status a :StoppedEarlyStatus . BIND (?trial AS ?stopped) }

  ?bySite rdfs:label "Neoplasms by Site"@en .
  ?area meshv:broaderDescriptor ?bySite ;
        rdfs:label ?areaName .
  ?condition meshv:broaderDescriptor* ?area .
}
GROUP BY ?areaName
ORDER BY DESC(?closedTrials)
