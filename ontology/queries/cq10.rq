# 10. ¿Por qué Rastro dice que un ensayo prueba un fármaco?
# La evidencia de cada enlace, con PROV-O: el texto del sponsor, lo que coincidió y la regla.
PREFIX oncologia: <https://w3id.org/rastro/oncologia#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?nct ?intervention ?matched ?rule ?source WHERE {
  VALUES ?name { "TRASTUZUMAB" }   # el fármaco a consultar
  ?link a oncologia:DrugLink ; oncologia:linkDrug ?drug ; oncologia:linkTrial ?trial ;
        oncologia:interventionText ?intervention ; oncologia:matchedText ?matched ; oncologia:linkRule ?rule ;
        prov:wasDerivedFrom ?src .
  ?drug oncologia:name ?name . ?trial oncologia:nctId ?nct . ?src oncologia:name ?source .
}
LIMIT 10
