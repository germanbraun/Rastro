# CQ11. ¿Qué ensayos de cáncer colorrectal combinan dos o más fármacos con mecanismos de
# acción distintos?
# Al trabajar por familia de ChEMBL, dos sales de la misma molécula son un solo fármaco.
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?nctId ?title (COUNT(DISTINCT ?moa) AS ?mechanisms)
       (GROUP_CONCAT(DISTINCT ?drugName; separator=" + ") AS ?drugs)
WHERE {
  ?trial :nctId ?nctId ;
         :title ?title ;
         :testsDrug ?drug ;
         :studiesCondition ?condition .
  ?drug rdfs:label ?drugName ;
        :hasMechanism/:mechanismOfAction ?moa .

  ?crc rdfs:label "Colorectal Neoplasms"@en .
  ?condition meshv:broaderDescriptor* ?crc .
}
GROUP BY ?nctId ?title
HAVING (COUNT(DISTINCT ?moa) >= 2)
ORDER BY DESC(?mechanisms)
