# CQ13. ¿De qué fuente y de qué carga viene cada dato de una respuesta?
# Ejemplo sobre la respuesta de CQ01: procedencia de cada fármaco y ensayo que aparece.
PREFIX : <https://w3id.org/rastro/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>

SELECT ?entity ?entityLabel ?sourceName ?license ?version ?loadedTable
WHERE {
  # Parámetro: las entidades de la respuesta (aquí, fármaco y ensayo de un resultado de CQ01)
  VALUES ?entity { <https://w3id.org/rastro/drug/CHEMBL1201585> <https://w3id.org/rastro/trial/NCT00000000> }
  ?entity :fromSource ?source .
  OPTIONAL { ?entity rdfs:label ?entityLabel }
  ?source rdfs:label ?sourceName ;
          :license ?license .
  OPTIONAL {
    ?load :loadOf ?source ;
          :version ?version ;
          :loadedTable ?loadedTable .
  }
}
