# 2. ¿Cuántos ensayos hay por fase para fármacos que actúan sobre EGFR?
PREFIX oncologia: <https://w3id.org/rastro/oncologia#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?phase (COUNT(DISTINCT ?trial) AS ?trials)
WHERE {
  ?t oncologia:gene "EGFR" .
  ?d oncologia:hasTarget ?t .
  ?trial oncologia:testsDrug ?d ; oncologia:phase ?phase .
}
GROUP BY ?phase
ORDER BY ?phase
