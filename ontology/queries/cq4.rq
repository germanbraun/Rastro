# 4. ¿Cuáles son los eventos adversos más reportados de los fármacos que se prueban en leucemia?
# Conteos de reportes espontáneos de FAERS, no frecuencias clínicas.
PREFIX oncologia: <https://w3id.org/rastro/oncologia#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?reaction (SUM(?n) AS ?reports)
WHERE {
  {
    SELECT DISTINCT ?d WHERE {
      ?trial oncologia:testsDrug ?d ; oncologia:condition ?c .
      ?leukemia rdfs:label "Leukemia"@en .
      ?c oncologia:within ?leukemia .
    }
  }
  ?r oncologia:drug ?d ; oncologia:reaction ?reaction ; oncologia:reports ?n .
}
GROUP BY ?reaction
ORDER BY DESC(?reports)
LIMIT 20
