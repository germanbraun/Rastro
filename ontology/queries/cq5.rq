# 5. ¿Qué otros fármacos actúan sobre los mismos targets que imatinib?
PREFIX oncologia: <https://w3id.org/rastro/oncologia#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?drug (GROUP_CONCAT(DISTINCT ?gene; separator=", ") AS ?sharedTargets)
WHERE {
  ?imatinib oncologia:name "IMATINIB" ; oncologia:hasTarget ?t .
  ?other oncologia:hasTarget ?t ; oncologia:name ?drug .
  ?t oncologia:gene ?gene .
  FILTER (?other != ?imatinib)
}
GROUP BY ?drug
ORDER BY ?drug
