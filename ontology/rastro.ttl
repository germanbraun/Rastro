@prefix oncologia: <https://w3id.org/rastro/oncologia#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meshv: <http://id.nlm.nih.gov/mesh/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/rastro/oncologia> a owl:Ontology ;
    rdfs:label "Ontología de Rastro"@es ;
    rdfs:comment """Lo mínimo para responder las preguntas de competencia: ensayos, fármacos,
targets, sponsors y eventos adversos. Las condiciones son los descriptores de MeSH,
sin clase propia. Los fármacos tienen clases según ATC; «terapia dirigida» no tiene
mapeo: Ontop la deduce de sus subclases. Cada enlace ensayo → fármaco lleva su
evidencia, con PROV-O."""@es ;
    owl:versionInfo "0.3" .

# Clases ---------------------------------------------------------

oncologia:Trial a owl:Class ;
    rdfs:label "Ensayo clínico"@es ;
    rdfs:comment "Un estudio de ClinicalTrials.gov (AACT)."@es .

oncologia:Drug a owl:Class ;
    rdfs:label "Fármaco"@es ;
    rdfs:comment "Un fármaco de ChEMBL. Sus sales cuentan como el mismo fármaco."@es .

oncologia:TargetedTherapy a owl:Class ;
    rdfs:subClassOf oncologia:Drug ;
    rdfs:label "Terapia dirigida"@es ;
    rdfs:comment "Un fármaco que actúa sobre una proteína que el tumor necesita. Ningún mapeo la asigna: se deduce de sus subclases."@es .

oncologia:KinaseInhibitor a owl:Class ;
    rdfs:subClassOf oncologia:TargetedTherapy ;
    rdfs:label "Inhibidor de quinasa"@es ;
    rdfs:comment "Molécula pequeña que bloquea una enzima del tumor (ATC L01E). Sus nombres terminan en -nib."@es .

oncologia:MonoclonalAntibody a owl:Class ;
    rdfs:subClassOf oncologia:TargetedTherapy ;
    rdfs:label "Anticuerpo monoclonal"@es ;
    rdfs:comment "Anticuerpo que se une a una proteína específica, incluidos los conjugados (ATC L01F). Sus nombres terminan en -mab."@es .

oncologia:Chemotherapy a owl:Class ;
    rdfs:subClassOf oncologia:Drug ;
    rdfs:label "Quimioterapia"@es ;
    rdfs:comment "Fármaco citotóxico clásico: alquilantes, antimetabolitos, alcaloides y antibióticos citotóxicos (ATC L01A a L01D)."@es .

oncologia:HormoneTherapy a owl:Class ;
    rdfs:subClassOf oncologia:Drug ;
    rdfs:label "Terapia hormonal"@es ;
    rdfs:comment "Fármaco que actúa sobre hormonas, como los antiandrógenos o los antiestrógenos (ATC L02)."@es .

oncologia:Target a owl:Class ;
    rdfs:label "Target"@es ;
    rdfs:comment "La proteína sobre la que actúa un fármaco (ChEMBL)."@es .

oncologia:Sponsor a owl:Class ;
    rdfs:label "Sponsor"@es ;
    rdfs:comment "La organización que lidera un ensayo."@es .

oncologia:YearlyReports a owl:Class ;
    rdfs:label "Reportes de eventos adversos por año"@es ;
    rdfs:comment "Cuántos reportes de FAERS (openFDA) mencionan un fármaco en un año. Son reportes espontáneos, no frecuencias clínicas."@es .

oncologia:ReportedReaction a owl:Class ;
    rdfs:label "Reacción reportada"@es ;
    rdfs:comment "Una reacción adversa y cuántos reportes de FAERS la mencionan para un fármaco."@es .

oncologia:DataSource a owl:Class ;
    rdfs:label "Fuente de datos"@es ;
    rdfs:comment "AACT, ChEMBL, openFDA o MeSH."@es .

# Relaciones -----------------------------------------------------

oncologia:testsDrug a owl:ObjectProperty ;
    rdfs:label "prueba el fármaco"@es ;
    rdfs:domain oncologia:Trial ; rdfs:range oncologia:Drug .

oncologia:condition a owl:ObjectProperty ;
    rdfs:label "condición"@es ;
    rdfs:comment "La enfermedad que estudia el ensayo, como descriptor de MeSH. Sus subtipos se encuentran con oncologia:within."@es ;
    rdfs:domain oncologia:Trial ; rdfs:range meshv:Descriptor .

oncologia:within a owl:ObjectProperty ;
    rdfs:label "está dentro de"@es ;
    rdfs:comment "Un descriptor de MeSH está dentro de sí mismo y de todos sus ancestros. Así \"cáncer de pulmón y sus subtipos\" es una sola condición: ?c oncologia:within ?pulmon."@es ;
    rdfs:domain meshv:Descriptor ; rdfs:range meshv:Descriptor .

oncologia:sponsor a owl:ObjectProperty ;
    rdfs:label "sponsor"@es ;
    rdfs:domain oncologia:Trial ; rdfs:range oncologia:Sponsor .

oncologia:hasTarget a owl:ObjectProperty ;
    rdfs:label "actúa sobre"@es ;
    rdfs:domain oncologia:Drug ; rdfs:range oncologia:Target .

oncologia:drug a owl:ObjectProperty ;
    rdfs:label "fármaco"@es ;
    rdfs:comment "El fármaco al que se refiere un conteo de reportes."@es ;
    rdfs:range oncologia:Drug .

oncologia:fromSource a owl:ObjectProperty ;
    rdfs:label "proviene de"@es ;
    rdfs:comment "La fuente de la que viene un dato. Es la marca de procedencia que muestra Rastro Layer."@es ;
    rdfs:range oncologia:DataSource .

# Atributos ------------------------------------------------------

oncologia:name a owl:DatatypeProperty ; rdfs:label "nombre"@es ; rdfs:range xsd:string .

oncologia:nctId a owl:DatatypeProperty ; rdfs:label "NCT ID"@es ; rdfs:domain oncologia:Trial ; rdfs:range xsd:string .
oncologia:title a owl:DatatypeProperty ; rdfs:label "título"@es ; rdfs:domain oncologia:Trial ; rdfs:range xsd:string .
oncologia:phase a owl:DatatypeProperty ; rdfs:label "fase"@es ;
    rdfs:comment "Como en ClinicalTrials.gov: PHASE1, PHASE2, PHASE3, PHASE4, PHASE1/PHASE2…"@es ;
    rdfs:domain oncologia:Trial ; rdfs:range xsd:string .
oncologia:status a owl:DatatypeProperty ; rdfs:label "estado"@es ;
    rdfs:comment "Como en ClinicalTrials.gov: RECRUITING, COMPLETED, TERMINATED, WITHDRAWN…"@es ;
    rdfs:domain oncologia:Trial ; rdfs:range xsd:string .
oncologia:startDate a owl:DatatypeProperty ; rdfs:label "fecha de inicio"@es ; rdfs:domain oncologia:Trial ; rdfs:range xsd:date .
oncologia:whyStopped a owl:DatatypeProperty ; rdfs:label "motivo de detención"@es ; rdfs:domain oncologia:Trial ; rdfs:range xsd:string .
oncologia:stopReason a owl:DatatypeProperty ; rdfs:label "motivo de detención, clasificado"@es ;
    rdfs:comment "El motivo que escribió el sponsor, clasificado con reglas legibles (linking/stop_reasons.sql): No consiguieron pacientes, Decisión de la empresa, El tratamiento no funcionó, Problemas de seguridad… Un ensayo puede tener varios. Su evidencia está en oncologia:StopReasonLink."@es ;
    rdfs:domain oncologia:Trial ; rdfs:range xsd:string .

oncologia:chemblId a owl:DatatypeProperty ; rdfs:label "ChEMBL ID"@es ; rdfs:domain oncologia:Drug ; rdfs:range xsd:string .
oncologia:approved a owl:DatatypeProperty ; rdfs:label "aprobado"@es ;
    rdfs:comment "Verdadero si el fármaco está aprobado en alguna indicación (fase máxima 4 en ChEMBL)."@es ;
    rdfs:domain oncologia:Drug ; rdfs:range xsd:boolean .

oncologia:gene a owl:DatatypeProperty ; rdfs:label "gen"@es ;
    rdfs:comment "Símbolo del gen del target, por ejemplo ERBB2 o EGFR."@es ;
    rdfs:domain oncologia:Target ; rdfs:range xsd:string .

oncologia:industry a owl:DatatypeProperty ; rdfs:label "es industria"@es ;
    rdfs:domain oncologia:Sponsor ; rdfs:range xsd:boolean .

oncologia:year a owl:DatatypeProperty ; rdfs:label "año"@es ; rdfs:domain oncologia:YearlyReports ; rdfs:range xsd:integer .
oncologia:reports a owl:DatatypeProperty ; rdfs:label "reportes"@es ; rdfs:range xsd:integer .
oncologia:seriousReports a owl:DatatypeProperty ; rdfs:label "reportes serios"@es ; rdfs:domain oncologia:YearlyReports ; rdfs:range xsd:integer .
oncologia:reaction a owl:DatatypeProperty ; rdfs:label "reacción"@es ; rdfs:domain oncologia:ReportedReaction ; rdfs:range xsd:string .
oncologia:license a owl:DatatypeProperty ; rdfs:label "licencia"@es ; rdfs:domain oncologia:DataSource ; rdfs:range xsd:string .

# Procedencia de los enlaces (PROV-O, el estándar del W3C) ---------

prov:Entity a owl:Class ; rdfs:label "entidad (PROV)"@es .
prov:wasDerivedFrom a owl:ObjectProperty ; rdfs:label "deriva de"@es .
prov:wasGeneratedBy a owl:ObjectProperty ; rdfs:label "generado por"@es .

oncologia:DrugLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Enlace ensayo → fármaco"@es ;
    rdfs:comment "La evidencia de que un ensayo prueba un fármaco: qué texto de la intervención coincidió con qué nombre de ChEMBL, y con qué regla. Lo genera el entity linking y deriva de AACT y de ChEMBL."@es .

oncologia:linkTrial a owl:ObjectProperty ; rdfs:label "ensayo del enlace"@es ; rdfs:domain oncologia:DrugLink ; rdfs:range oncologia:Trial .
oncologia:linkDrug a owl:ObjectProperty ; rdfs:label "fármaco del enlace"@es ; rdfs:domain oncologia:DrugLink ; rdfs:range oncologia:Drug .
oncologia:interventionText a owl:DatatypeProperty ; rdfs:label "texto de la intervención"@es ;
    rdfs:comment "Lo que escribió el sponsor en ClinicalTrials.gov, por ejemplo «Bevacizumab (drug), Herceptin (drug)»."@es ;
    rdfs:domain oncologia:DrugLink ; rdfs:range xsd:string .
oncologia:matchedText a owl:DatatypeProperty ; rdfs:label "texto que coincidió"@es ; rdfs:domain oncologia:DrugLink ; rdfs:range xsd:string .
oncologia:linkRule a owl:DatatypeProperty ; rdfs:label "regla"@es ;
    rdfs:comment "Cómo se reconoció el fármaco: nombre, alias, combinación, régimen o palabras (nombre como palabra entera)."@es ;
    rdfs:domain oncologia:DrugLink ; rdfs:range xsd:string .

# Por qué se detuvo cada ensayo: un hecho del grafo, con su evidencia (PROV-O) ------

oncologia:StopReasonLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Motivo de detención clasificado"@es ;
    rdfs:comment "La evidencia de un motivo: qué parte del texto del sponsor coincidió con qué regla. Lo genera la clasificación por reglas y deriva de AACT."@es .
oncologia:aboutTrial a owl:ObjectProperty ; rdfs:label "ensayo"@es ; rdfs:domain oncologia:StopReasonLink ; rdfs:range oncologia:Trial .
oncologia:reasonLabel a owl:DatatypeProperty ; rdfs:label "motivo"@es ; rdfs:domain oncologia:StopReasonLink ; rdfs:range xsd:string .
oncologia:evidenceText a owl:DatatypeProperty ; rdfs:label "texto que coincidió con la regla"@es ; rdfs:domain oncologia:StopReasonLink ; rdfs:range xsd:string .

